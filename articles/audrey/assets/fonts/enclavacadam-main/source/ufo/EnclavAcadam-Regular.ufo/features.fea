# automatic
@Uppercase = [ A Aacute Acircumflex Agrave B C Ccedilla D E Eacute Ecircumflex Egrave Emacron F G H I Iacute Icircumflex Idieresis Igrave J K L M N O Oacute Ocircumflex Ograve P Q R S T U Ugrave V W X Y Z U.ss01 A_M A_N A_U_K A_V C_A C_O D_O_L D_U E_E E_I E_N E_N_T E_S E_T E_T_E E_T_T_E E_Z Eacute_E Eacute_E_S F_V H_U I_E_L I_S_T_E L_A L_E_S L_I_S_T_E L_L L_O_I L_O_S L_S M_E_N_T N_N O_C O_E O_I O_Idieresis_X O_L_A O_N_L O_U O_Y P_L P_L_A P_O Q_U R_R R_S R_X S_O_N S_S T_E T_I_O_N T_T T_T_E V_A V_R V_S X_S C_E_U_L_S.ss01 E_U_L.ss01 I_O_L.ss01 S_O.ss01 U_L.ss01 O_L.ss02 O_L_S.ss02 R_R.ss02 U_X.ss02 Y_O_L.ss02 I_O_L.ss03 L_S.ss03 O_L_S.ss03 S_O.ss03 Y_O_L.ss03 O_L.ss04 ];

# Prefix: Languagesystems
# automatic
languagesystem DFLT dflt;

feature aalt {
# automatic
feature case;
feature ss01;
feature ss02;
feature ss03;
feature ss04;
} aalt;

feature case {
sub periodcentered by periodcentered.case;
} case;

feature ss01 {
# automatic
featureNames {
	name "";
};
sub U by U.ss01;
sub C_E_U_L_S by C_E_U_L_S.ss01;
sub E_U_L by E_U_L.ss01;
sub I_O_L by I_O_L.ss01;
sub S_O by S_O.ss01;
sub U_L by U_L.ss01;
sub A_X by A_X.ss01;
sub E_X by E_X.ss01;
sub Ccedilla_O_L by Ccedilla_O_L.ss01;
} ss01;

feature ss02 {
# automatic
featureNames {
	name "";
};
sub O_L by O_L.ss02;
sub O_L_S by O_L_S.ss02;
sub R_R by R_R.ss02;
sub U_X by U_X.ss02;
sub Y_O_L by Y_O_L.ss02;
sub O_K by O_K.ss02;
sub C_E_U_L_S by C_E_U_L_S.ss02;
} ss02;

feature ss03 {
# automatic
featureNames {
	name "";
};
sub I_O_L by I_O_L.ss03;
sub L_S by L_S.ss03;
sub O_L_S by O_L_S.ss03;
sub S_O by S_O.ss03;
sub Y_O_L by Y_O_L.ss03;
sub Ccedilla_O_L by Ccedilla_O_L.ss03;
} ss03;

feature ss04 {
# automatic
featureNames {
	name "";
};
sub O_L by O_L.ss04;
sub A_N_L by A_N_L.ss04;
} ss04;

feature liga {
lookupflag IgnoreMarks;

lookup point {
      sub period period by periodcentered;
      sub period period period by ellipsis;
} point;

lookup pointcap {
	  sub @Uppercase periodcentered' by periodcentered.case;
	  sub periodcentered' @Uppercase by periodcentered.case;
} pointcap;


