a_e a_o a_u_l_a c_h c_q d_e d_u_d_e_l_a eacute_e e_a e_s e_t ecircumflex_t_e e_t_t e_t_t_e e_u e_s e_s_s_e f_e f_f_e f_v g_u h_o_f_e i_e i_l l_e l_l l_u l_u_i m_p n_a n_e  n_n o_f o_t o_idieresis o_t_e r_e r_egrave_r_e r_i r_s s_c s_c_e s_e s_e s_l s_l_l s_s s_t t_e t_t u_e u_l u_n_e x_c x_l x_l_l x_s
