lookup ligaturesbasiques{
    sub c t by c_t;
	sub f i by f_i;
	sub f l by f_l;
    sub f f by f_f;
    sub f f i by f_f_i;
    sub f f l by f_f_l;
	sub i j by i_j;
	sub s h by s_h;
    sub S H by S_H;
	sub s s by s_s;
	sub t t by t_t;
} ligaturesbasiques;
} liga;

feature dlig {
lookupflag IgnoreMarks;
sub S H by S_H;
sub c t by c_t;
sub i j by i_j;
sub s h by s_h;
sub s s by s_s;
sub t t by t_t;
} dlig;

