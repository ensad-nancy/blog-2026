sub B by B.ss01;
sub D by D.ss01;
sub O by O.ss01;
sub OE by OE.ss01;
sub P by P.ss01;
sub Thorn by Thorn.ss01;
sub Q by Q.ss01;
sub R by R.ss01;
sub D_E by D_E.ss01;
sub Eacute_E by Eacute_E.ss01;
sub L_E by L_E.ss01;
sub X_C by X_C.ss01;
sub a by a.ss01;
sub b by b.ss01;
sub d by d.ss01;
sub g by g.ss01;
sub m by m.ss01;
