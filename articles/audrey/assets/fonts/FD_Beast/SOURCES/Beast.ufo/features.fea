sub quotedblright by quotedblright.ss01;
} ss01;

feature ss02 {
# automatic
sub Eacute_E by Eacute_E.ss02;
sub a by a.ss02;
sub g by g.ss02;
sub d_e by d_e.ss02;
} ss02;

